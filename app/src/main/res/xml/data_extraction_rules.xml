<?xml version="1.0" encoding="utf-8"?>
<!-- Transcripts, recordings and API keys never leave the device through Android backup.
     Use Settings > Data > Export backup for an explicit, user-controlled export. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
